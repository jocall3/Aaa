{
  "name": "@microservices/rewards-service",
  "version": "1.0.0",
  "description": "Microservice for managing customer rewards, loyalty points, and redemptions within the DDD, Event-Sourced, CQRS architecture.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "start": "node dist/src/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "generate": "echo 'Running custom code generation...' && npm run generate:stubs && npm run generate:ports",
    "generate:stubs": "echo 'Generating server stubs from OpenAPI spec... (placeholder)'",
    "generate:ports": "echo 'Generating port interfaces from OpenAPI spec... (placeholder)'"
  },
  "keywords": [
    "microservice",
    "rewards",
    "ddd",
    "cqrs",
    "event-sourcing"
  ],
  "author": "Elite AI Implementation Team",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.5.0",
    "axios": "^1.2.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "kafkajs": "^2.2.3",
    "node-vault": "^0.10.0",
    "pg": "^8.8.0",
    "pino": "^8.7.0",
    "pino-pretty": "^9.1.1",
    "redis": "^4.5.0",
    "uuid": "^9.0.0",
    "zod": "^3.19.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.14",
    "@types/jest": "^29.2.3",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/node": "^18.11.9",
    "@types/pg": "^8.6.5",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.44.0",
    "@typescript-eslint/parser": "^5.44.0",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.3.1",
    "prettier": "^2.8.0",
    "ts-jest": "^29.0.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^4.9.3"
  }
}
