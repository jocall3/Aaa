{
  "name": "@elite-ai/code-generator",
  "version": "1.0.0",
  "description": "In-house code generation framework for the new microservices architecture. Consumes OpenAPI specifications to produce server-side stubs, port interfaces, DTOs, and client-side SDKs.",
  "private": true,
  "author": "Elite AI Implementation Team",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "generate-code": "bin/generate.js"
  },
  "scripts": {
    "generate": "ts-node src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "npm run build && node dist/index.js",
    "dev": "nodemon --watch 'src/**/*.ts' --watch 'templates/**/*.hbs' --exec 'ts-node' src/index.ts",
    "test": "jest --coverage",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "chalk": "^4.1.2",
    "change-case": "^4.1.2",
    "fs-extra": "^11.1.1",
    "handlebars": "^4.7.7",
    "js-yaml": "^4.1.0",
    "prettier": "^2.8.8",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.1",
    "@types/jest": "^29.5.2",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^20.3.3",
    "@types/prettier": "^2.7.3",
    "@types/yargs": "^17.0.24",
    "@typescript-eslint/eslint-plugin": "^5.60.1",
    "@typescript-eslint/parser": "^5.60.1",
    "eslint": "^8.44.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.5.0",
    "nodemon": "^2.0.22",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
