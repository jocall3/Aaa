{"type": "record", "namespace": "com.elite.financial.events.account", "name": "AccountCreated", "doc": "Represents the immutable fact that a new financial account has been created. This event is the source of truth for the creation of an Account aggregate.", "fields": [{"name": "accountId", "type": "string", "doc": "The unique identifier (UUID) for the newly created account aggregate."}, {"name": "userId", "type": "string", "doc": "The identifier (UUID) of the user who owns this account."}, {"name": "accountType", "type": {"type": "enum", "name": "AccountType", "namespace": "com.elite.financial.events.account.types", "doc": "Defines the types of accounts available.", "symbols": ["CHECKING", "SAVINGS", "CREDIT_CARD"]}, "doc": "The classification of the account."}, {"name": "currency", "type": "string", "doc": "The ISO 4217 currency code for the account's balance (e.g., 'USD', 'EUR')."}, {"name": "initialBalance", "type": "long", "doc": "The starting balance of the account in the smallest currency unit (e.g., cents)."}, {"name": "createdAt", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "The precise timestamp (in UTC milliseconds from the Unix epoch) indicating when the account creation occurred."}]}