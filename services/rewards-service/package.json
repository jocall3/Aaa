{
  "name": "@microservices-arch/rewards-service",
  "version": "1.0.0",
  "description": "A dedicated microservice for managing customer rewards, including loyalty points balances, earning, and redemption. Implements DDD, Event Sourcing, and CQRS patterns and participates in distributed sagas.",
  "private": true,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "start": "node dist/src/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "rimraf dist && tsc",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-sfn": "^3.525.0",
    "@bank/caching-client": "^1.0.0",
    "@bank/error-framework": "^1.0.0",
    "@bank/eventing": "^1.0.0",
    "@bank/authz-client": "^1.0.0",
    "@bank/saga-orchestrator": "^1.0.0",
    "@elastic/elasticsearch": "^8.12.2",
    "axios": "^1.6.7",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "node-vault": "^0.10.2",
    "pg": "^8.11.3",
    "pino": "^8.19.0",
    "pino-http": "^9.0.0",
    "uuid": "^14.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.25",
    "@types/pg": "^8.11.2",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "pino-pretty": "^10.3.1",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.2"
  },
  "author": "Elite AI Implementation Team",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  }
}
