{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": "./src",
    "jsx": "react-jsx" // Required for GraphQL libraries like Apollo
  },
  "include": ["src/**/*.ts", "src/**/*.graphql"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../../libs/caching-client" },
    { "path": "../../libs/error-framework" },
    { "path": "../../libs/eventing" }
  ]
}
